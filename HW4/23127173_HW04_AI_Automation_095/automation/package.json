{
  "name": "eshop-hw04-automation-23127173",
  "version": "1.0.0",
  "private": true,
  "description": "HW04 Playwright automation for EShop — MSSV 23127173",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:feature-a": "playwright test tests/feature-a-profile.spec.ts",
    "test:feature-a:headed": "playwright test tests/feature-a-profile.spec.ts --project=chromium --headed",
    "test:feature-b": "playwright test tests/feature-b-order-history.spec.ts",
    "test:feature-b:headed": "playwright test tests/feature-b-order-history.spec.ts --project=chromium --headed",
    "test:feature-c": "playwright test tests/feature-c-admin-orders.spec.ts",
    "test:feature-c:headed": "playwright test tests/feature-c-admin-orders.spec.ts --project=chromium --headed",
    "test:all-browsers": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:full-matrix": "node scripts/run-full-matrix.mjs",
    "report": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
