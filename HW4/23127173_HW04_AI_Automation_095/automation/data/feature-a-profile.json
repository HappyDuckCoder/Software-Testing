      "action": "ui_view_profile",
      "assertionPattern": "url"
    },
    {
      "id": "A-AUTO-02",
      "hw2Ref": "A-DT-02",
      "type": "positive",
      "description": "GET /api/users/me với token hợp lệ",
      "action": "api_get_me",
      "assertionPattern": "count"
    },
    {
      "id": "A-AUTO-03",
      "hw2Ref": "A-DT-03",
      "type": "negative",
      "description": "GET /api/users/me thiếu token → 401",
      "action": "api_get_me_no_auth",
      "expected": { "httpStatus": 401 },
      "assertionPattern": "state"
    },
    {
      "id": "A-AUTO-04",
      "hw2Ref": "A-DT-04",
      "type": "negative",
      "description": "GET /api/users/me token sai → 403",
      "action": "api_get_me_bad_token",
      "expected": { "httpStatus": 403 },
      "assertionPattern": "state"
    },
    {
      "id": "A-AUTO-05",
      "hw2Ref": "A-DT-05",
      "type": "positive",
      "description": "PUT hồ sơ hợp lệ qua API (phone spec 0912345678)",
      "action": "api_put_profile",
      "input": { "name": "Nguyen Van A", "phone": "0912345678", "shipping_address": "227 Nguyen Van Cu" },
      "expected": { "outcome": "success", "verifyPersist": true },
      "assertionPattern": "text"
    },
